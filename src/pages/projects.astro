---
import Title from "../components/title.astro";
import MainLayout from "../layouts/main-layout.astro";
---

<MainLayout title="Matteo Ricciotti Portfolio - Projects" description="My most relevant projects">
    <div>
        <Title title="Projects" />
        <div id="projects-container" class="mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-10"></div>
    </div>
</MainLayout>

<script>
    import { PROJECTS } from "../constants/projects"

    const projectsContainer = document.querySelector('#projects-container')   

    if(projectsContainer){
        projectsContainer.innerHTML = PROJECTS.map(({ code, name, image }) =>
            `
            <a class="mx-auto" href="/projects/${code}">
                <img class="size-64 min-w-64 object-cover rounded-lg" src="${image}" alt="${name}"/>
            </a>
            `
        ).join('')
    }

</script>