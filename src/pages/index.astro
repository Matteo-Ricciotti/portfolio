---
import Avatar from "../components/avatar.astro";
import Title from "../components/title.astro";
import MainLayout from "../layouts/main-layout.astro";
---

<MainLayout
    title="Matteo Ricciotti Portfolio - Home"
    description="Software Developer Porfolio that show my set of skills, experiences and projects"
>
    <div class="flex flex-col items-center justify-between text-center md:flex-row md:text-left">
        <div class="order-2 md:order-none">
            <p class="mb-2">Software Developer</p>
            <Title moreClass="flex flex-col gap-2">
                <span class="hidden lg:inline">Hello there I'm</span>
                <span class="lg:hidden">Hello I'm</span>
                <span class="text-accent">Matteo Ricciotti</span>
            </Title>
            <p class="my-6 max-w-[450px] leading-8 tracking-widest text-white/80">
                Lorem ipsum dolor sit amet consectetur adipisicing elit. Quod commodi vitae maxime sequi est voluptatum
                aut id aliquam.
            </p>
        </div>
        <Avatar />
    </div>
</MainLayout>
