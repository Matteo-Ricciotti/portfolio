---
import Title from "../components/title.astro";
import MainLayout from "../layouts/main-layout.astro";
---

<MainLayout
    title="Matteo Ricciotti Portfolio - Home"
    description="Software Developer Porfolio that show my set of skills, experiences and projects"
>
    <div class="relative h-fit">
        <Title>Hi there 👋, I'm <span class="text-accent">Matteo Ricciotti</span>!</Title>
        <div id="typed-strings">
            <p>
                <span class="text-lg"></span>I am a <strong class="text-lg">Fullstack Software Developer</strong>
            </p>
            <p>
                <span class="text-lg"></span>I <em>work</em> with <strong class="text-lg">RectJS</strong>
                and <strong class="text-lg">NodeJS</strong>
            </p>
            <p>
                <span class="text-lg"></span>I am a passionate <strong class="text-lg">Guitarist</strong>
            </p>
            <p>
                <span class="text-lg"></span>I frequently go to the <strong class="text-lg">Gym</strong>
            </p>
        </div>

        <div class="absolute -bottom-12 left-0 right-0 text-center">
            <span id="typed"></span>
        </div>
    </div>
</MainLayout>

<script>
    import Typed from "typed.js";

    new Typed("#typed", {
        stringsElement: "#typed-strings",
        typeSpeed: 50,
        loop: true,
    });
</script>
