---
import { Image } from "astro:assets";
// import meImage from "../../public/me.png";
import MainLayout from "../layouts/main-layout.astro";
import { Title } from "@/components/react/text/title";
import { Description } from "@/components/react/text/description";
import { GitHub } from "@/components/react/assets/github";
import { LinkedIn } from "@/components/react/assets/linkedin";
import { Avatar } from "@/components/react/avatar";
import { ABOUT } from "@/constants/about";
import { Button } from "@/components/react/ui/button";
import { Eye } from "@/components/react/assets/eye";
---

<MainLayout
    title=`${ABOUT.NAME} ${ABOUT.SURNAME} Portfolio`
    description="Software Developer: my set of skills, experiences and projects"
>
    <div class="flex flex-col items-center justify-between text-center md:flex-row md:text-left">
        <div class="order-2 w-full md:order-none md:max-w-[50%]">
            <div class="flex flex-col gap-2">
                <p>Software Developer</p>
                <Title className="flex flex-col gap-2">
                    <span class="hidden lg:inline">Hello there I'm</span>
                    <span class="lg:hidden">Hello I'm</span>
                    <span class="text-accent">{ABOUT.NAME}&nbsp;{ABOUT.SURNAME}</span>
                </Title>
            </div>
            <Description
                >Lorem ipsum dolor sit amet consectetur adipisicing elit. Lorem ipsum dolor sit amet consectetur
                adipisicing elit.
            </Description>
            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
                <Button id="download-cv" variant="outline">
                    VIEW CV
                    <Eye />
                </Button>
                <div class="flex gap-3 md:mr-auto">
                    <Button id="github-link" size="icon" variant="outline">
                        <GitHub />
                    </Button>
                    <Button id="linkedin-link" size="icon" variant="outline">
                        <LinkedIn />
                    </Button>
                </div>
            </div>
        </div>
        <div class="md:max-w-[50%]">
            <Avatar client:load>
                <!-- <Image class="size-9/12 rounded-full object-cover" src={meImage} alt=`${ABOUT.NAME} ${ABOUT.SURNAME}` /> -->
            </Avatar>
        </div>
    </div>
</MainLayout>

<script>
    const downloadCv = document.querySelector("button#download-cv");
    const githubLink = document.querySelector("button#github-link");
    const linkedinLink = document.querySelector("button#linkedin-link");

    if (downloadCv && githubLink && linkedinLink) {
        downloadCv.addEventListener("click", () => window.open("/files/CV.pdf"));
        githubLink.addEventListener("click", () => window.open("https://github.com/Matteo-Ricciotti"));
        linkedinLink.addEventListener("click", () => window.open("https://www.linkedin.com/in/matteo-ricciotti"));
    }
</script>
