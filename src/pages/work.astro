---
import ProjectDetails from "../components/project-details.astro";
import { PROJECTS } from "../constants/projects";
import MainLayout from "../layouts/main-layout.astro";
---

<MainLayout title="Matteo Ricciotti - Work" description="Most relevant projects">
    <div class="grid gap-20">
        {
            PROJECTS.map((project, i) => (
                <>
                    <ProjectDetails number={i + 1} swap={i % 2 !== 0} {...project} />
                    {i !== PROJECTS.length - 1 && <div class="w-full border border-dashed border-accent/50" />}
                </>
            ))
        }
    </div>
</MainLayout>
