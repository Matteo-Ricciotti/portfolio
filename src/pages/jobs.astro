---
import { Title } from "@/components/react/text/title";
import MainLayout from "../layouts/main-layout.astro";
import { Description } from "@/components/react/text/description";
import { ABOUT } from "@/constants/about";
---

<MainLayout title=`${ABOUT.NAME} ${ABOUT.SURNAME} - Jobs` ` description="My job experiences">
    <div class="flex flex-col items-center gap-10 text-center">
        <div>
            <Title>Jobs</Title>
            <Description>Description</Description>
        </div>
        <div class="grid grid-cols-2 gap-10 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"></div>
    </div>
</MainLayout>
