---
import Header from "../components/header.astro";
import { SEO } from "astro-seo";
import Footer from "../components/footer.astro";

type Props = {
    title: string;
    description: string;
};

const { title, description } = Astro.props;
---

<html lang="en">
    <head>
        <!-- SEO -->
        <SEO title={title} description={description} />

        <!-- Base -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <!-- Icon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Font -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
            rel="stylesheet"
        />

        <!-- Page animation -->
        <!-- <ViewTransitions /> -->
    </head>
    <body class="container grid min-h-screen gap-0 bg-primary text-white">
        <Header />
        <main transition:animate="slide">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    body {
        font-family: "JetBrains Mono";
    }
</style>
