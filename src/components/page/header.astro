---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { NavbarTab } from "../react/ui/navbar-tab";

const { pathname } = Astro.url;
---

<header class="h-fit py-8 md:flex">
    <Astronav>
        <div class="mr-auto flex items-center justify-between">
            <a href="/" class="text-2xl tracking-wide sm:text-3xl">Matteo<strong class="text-accent">.</strong></a>
            <MenuIcon class="size-6 text-white sm:size-8 md:hidden" />
        </div>
        <MenuItems class="hidden items-center md:flex">
            <ul
                class="absolute right-4 top-20 z-10 flex flex-col gap-6 rounded-lg text-xl max-md:bg-black/20 max-md:p-4 max-md:backdrop-blur-sm md:static md:flex-row md:gap-14 md:text-lg"
            >
                <NavbarTab path="/" label="Home" pathname={pathname} />
                <NavbarTab path="/work" label="Work" pathname={pathname} />
                <NavbarTab path="/about" label="About" pathname={pathname} />
            </ul>
        </MenuItems>
    </Astronav>
</header>
