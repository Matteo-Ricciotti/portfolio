---
import { cn } from "../utils";

type Props = {
    path: string;
    label: string;
};

const { pathname } = Astro.url;
const { path, label } = Astro.props;
---

<li>
    <a href={path} class=`${cn("transition-all hover:text-accent-hover", pathname === path && "text-accent")}`
        >{label}</a
    >
</li>
