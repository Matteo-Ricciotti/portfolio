---
type Props = astroHTML.JSX.AnchorHTMLAttributes;

const props = Astro.props;
---

<a
    class="group flex items-center gap-2 rounded-full border border-accent-hover px-6 py-3 font-medium tracking-wide text-accent-hover transition-all hover:bg-accent-hover hover:text-primary"
    {...props}
>
    <slot />
</a>
