<div
    id="avatar-container"
    class="relative order-1 flex size-[198px] flex-col items-center justify-center max-md:mb-10 sm:size-[298px] md:size-[348px] xl:size-[398px]"
>
    <canvas id="avatar-canvas" class="absolute size-full"></canvas>
    <img class="size-9/12 rounded-full object-cover" src="/me.png" alt="Matteo Ricciotti" />
</div>

<script>
    const container = document.querySelector("div#avatar-container")!;

    const canvas = document.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;

    canvas.width = container.clientWidth;
    canvas.height = container.clientHeight;

    ctx.strokeStyle = "#00ff99";
    ctx.lineWidth = 2;

    const startLongDash = 60;
    const startShortDash = 15;
    const gap = 40;

    const maxLongDash = 180;

    let longDash = startLongDash;
    let shortDash = startShortDash;

    let offset = 0;
    let increment = 0.2;
    let descending = false;

    const animate = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        ctx.beginPath();
        ctx.arc(canvas.width / 2, canvas.height / 2, canvas.width / 2 - 4, 0, Math.PI * 2);
        ctx.setLineDash([longDash, gap, shortDash, gap, longDash, gap, shortDash, gap]);

        ctx.lineDashOffset = -offset;

        ctx.stroke();

        offset += 1;

        if (longDash >= maxLongDash || descending) {
            longDash -= increment;
            shortDash -= increment;

            if (!descending) {
                descending = true;
            }
        }

        if (longDash <= startLongDash || !descending) {
            longDash += increment;
            shortDash += increment;

            if (descending) {
                descending = false;

                longDash = startLongDash;
                shortDash = startShortDash;
            }
        }

        requestAnimationFrame(animate);
    };

    animate();
</script>
