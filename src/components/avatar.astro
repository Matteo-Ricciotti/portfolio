---
import { Image } from "astro:assets";
import meImage from "../../public/me.png";
---

<div
    id="avatar-container"
    class="relative order-1 flex size-[198px] flex-col items-center justify-center max-md:mb-10 sm:size-[298px] md:size-[348px] xl:size-[398px]"
>
    <canvas id="avatar-canvas" class="absolute size-full"></canvas>
    <Image class="size-9/12 rounded-full object-cover" src={meImage} alt="Matteo Ricciotti" />
</div>

<script>
    const container = document.querySelector("div#avatar-container")!;

    const canvas = document.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;

    canvas.width = container.clientWidth;
    canvas.height = container.clientHeight;

    ctx.strokeStyle = "rgba(83, 221, 108, 1)";
    ctx.lineWidth = 2;

    const longDash = 60;
    const shortDash = 15;
    const gap = 40;

    let offset = 0;

    const animate = () => {
        ctx.lineDashOffset = -offset;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        ctx.beginPath();
        ctx.arc(canvas.width / 2, canvas.height / 2, canvas.width / 2 - 4, 0, Math.PI * 2);
        ctx.setLineDash([longDash, gap, shortDash, gap]);
        ctx.stroke();

        offset += 0.7;

        requestAnimationFrame(animate);
    };

    animate();
</script>
