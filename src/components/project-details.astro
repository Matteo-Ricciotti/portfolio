---
import Description from "./text/description.astro";
import Title from "./text/title.astro";
import OutlineText from "./text/outline-text.astro";
import SkillLink from "./text/skill-link.astro";
import IconLink from "./icon-link.astro";
import ArrowRight from "../assets/arrow-right.astro";
import Github from "../assets/github.astro";
import { SKILLS } from "../constants/skills";
import type { Project } from "../constants/projects";

type Props = Project & {
    number: number;
    swap?: boolean;
};

const { number, name, description, image, stack, link, github, swap } = Astro.props;

const technologies = stack.map((id) => {
    const skillData = SKILLS.find((skill) => skill.id === id);
    if (!skillData) throw new Error(`Missing technology with id '${id}'`);
    return skillData;
});
---

<div class="flex flex-col items-center justify-between text-center md:flex-row md:text-left">
    <div class=`${swap ? "md:order-1 " : "md:order-2"}`>
        <OutlineText>{String(number).padStart(2, "0")}</OutlineText>
        <Title>{name}</Title>
        <Description>{description}</Description>
        <div
            class="flex w-full max-w-full flex-col items-center md:max-w-[350px] md:items-start lg:max-w-[550px] xl:max-w-[650px]"
        >
            <ul class="flex flex-wrap justify-center gap-2 text-accent md:justify-start">
                {
                    technologies.map(({ url, name }, i) => (
                        <>
                            <SkillLink url={url}>{name}</SkillLink>
                            {i !== technologies.length - 1 && <li>-</li>}
                        </>
                    ))
                }
            </ul>
            <div class="mb-4 mt-2 w-full border border-white/20"></div>
            <div class="flex gap-4">
                <IconLink href={link} target="_blank" disabledText="Link not available" darker>
                    <ArrowRight class=`-rotate-45 transition-all ${link ? "hover:rotate-0" : ""}` />
                </IconLink>
                <IconLink href={github} target="_blank" disabledText="Closed source" darker>
                    <Github />
                </IconLink>
            </div>
        </div>
    </div>
    <div class=`${swap ? "md:order-2" : "md:order-1"}`>
        <img class="size-72 object-cover" src=`/projects/${image}` alt={name} />
    </div>
</div>
