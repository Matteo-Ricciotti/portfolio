---
type Props = astroHTML.JSX.AnchorHTMLAttributes & {
    disabledText?: string;
    darker?: boolean;
};

const { href, disabledText, darker, ...props } = Astro.props;

const classes = darker
    ? `border-transparent bg-white/10 ${href ? "hover:text-accent" : ""}`
    : `border-accent-hover  text-accent-hover  ${href ? "hover:bg-accent-hover hover:text-primary" : ""}`;

const disabledClasses = !href ? "opacity-50 cursor-not-allowed" : "";
---

<a
    title={disabledText}
    href={href}
    aria-disabled={!href}
    class=`rounded-full border p-1.5 transition-all cursor-pointer ${classes} ${disabledClasses}`
    {...props}
>
    <slot />
</a>
