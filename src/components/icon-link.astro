---
import { cn } from "../utils";

type Props = astroHTML.JSX.AnchorHTMLAttributes & {
    href?: string | null;
    disabledText?: string;
    darker?: boolean;
};

const { href, disabledText, darker, ...props } = Astro.props;
---

<a
    title={!href ? disabledText : href}
    href={href}
    aria-disabled={!href}
    class=`${cn(
        "rounded-full p-1.5 transition-all border border-accent-hover text-accent-hover",
        !darker && "hover:bg-accent-hover hover:text-primary",
        darker && "border-none bg-white/10 text-white",
        darker && href && "hover:text-accent-hover",
        !href && "opacity-50 cursor-not-allowed",
    )}`
    {...props}
>
    <slot />
</a>
